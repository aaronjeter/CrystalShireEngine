; first 6 custom pals look like regular ones
INCLUDE "gfx/battle_anims/battle_anims.pal"

if !DEF(MONOCHROME)
; metallic
	RGB 31, 31, 31
	RGB 20, 20, 20
	RGB 10, 10, 10
	RGB 00, 00, 00
; purple
	RGB 31, 31, 31
	RGB 22, 05, 24
	RGB 10, 02, 11
	RGB 00, 00, 00
; ice
	RGB 31, 31, 31
	RGB 00, 22, 29
	RGB 06, 18, 30
	RGB 00, 00, 00
; fire
	RGB 31, 31, 31
	RGB 31, 24, 02
	RGB 29, 03, 04
	RGB 00, 00, 00
; orb (for Zap Cannon's orb: its outline uses colors 1-2 and its
; inside uses color 3, so color 3 is dark blue here instead of black)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 24, 29, 31 ; outline highlights: very light blue
	RGB 14, 22, 31 ; outline: light blue
	RGB 02, 05, 22 ; inside: dark blue
; steel (for Swift's star in Meteor Mash: the star is filled with color 1
; and outlined with color 3, so those two carry the metal look)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 17, 18, 20 ; fill: metallic gray
	RGB 15, 17, 22 ; unused by the star: mid steel
	RGB 06, 08, 14 ; outline: dark steel blue
; scald (for Bubblebeam's bubbles in Scald: the small bubble is shaded
; with color 1 and outlined with color 3, so those two carry the orange)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 31, 18, 06 ; shading: orange
	RGB 31, 12, 03 ; unused by the small bubble: deep orange
	RGB 20, 07, 02 ; outline: burnt orange
; gem (for Ice Beam's crystal in Power Gem: color 1 is the highlight facet,
; color 2 the shaded facet and color 3 the outline, giving an amethyst)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 27, 21, 31 ; highlight facet: light lavender
	RGB 19, 08, 27 ; shaded facet: amethyst purple
	RGB 08, 02, 13 ; outline: dark violet
; pink (for Sand Attack's dust in Pixie Dust)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 31, 22, 28 ; light pink
	RGB 31, 12, 22 ; pink
	RGB 20, 04, 14 ; dark pink
; firefly (for Hyper Beam's beam in Signal Beam: a glowing yellow-green)
	RGB 31, 31, 31 ; unused (transparent for sprites)
	RGB 28, 31, 12 ; glow: pale yellow-green
	RGB 16, 29, 04 ; bright lime
	RGB 04, 12, 02 ; dark green
else
rept NUM_CUSTOM_BATTLE_PALETTES - 6
	MONOCHROME_RGB_FOUR
endr
endc
